<dtml-var manage_page_header>
<dtml-var manage_tabs>

<main class="container-fluid">
  <form action="manage_edit" method="post">

    <div class="form-group row">
      <label class="col-sm-3 col-form-label">Id</label>
      <div class="col-sm-9">
        <p class="form-control-plaintext mb-0"><dtml-var id html_quote></p>
      </div>
    </div>

    <div class="form-group row">
      <label for="fb-title" class="col-sm-3 col-form-label">Title</label>
      <div class="col-sm-9">
        <input type="text" class="form-control" id="fb-title" name="title"
               value="<dtml-var title html_quote>">
      </div>
    </div>

    <div class="form-group row">
      <label class="col-sm-3 col-form-label">Driver</label>
      <div class="col-sm-9">
        <p class="form-control-plaintext mb-0"><code><dtml-var driver_name html_quote></code></p>
      </div>
    </div>

    <div class="form-group row">
      <label class="col-sm-3 col-form-label">FirebirdDA version</label>
      <div class="col-sm-9">
        <p class="form-control-plaintext mb-0"><dtml-var da_version html_quote></p>
      </div>
    </div>

    <div class="form-group row">
      <label for="fb-connection-string" class="col-sm-3 col-form-label">Data source</label>
      <div class="col-sm-9">
        <input type="text" class="form-control" id="fb-connection-string"
               name="connection_string" value="<dtml-var connection_string html_quote>">
        <small class="form-text text-muted">Space-separated <code>key=value</code> pairs:
          <code>dsn=host[:port]/path user=myname password=pass</code></small>
      </div>
    </div>

    <div class="form-group row">
      <div class="col-sm-3"></div>
      <div class="col-sm-9">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="fb-check"
                 name="check" value="YES" checked>
          <label class="form-check-label" for="fb-check">Connect immediately</label>
        </div>
      </div>
    </div>

    <div class="zmi-controls">
      <input class="btn btn-primary" type="submit" name="submit" value="Save changes">
    </div>
  </form>
</main>

<dtml-var manage_page_footer>

<dtml-var manage_page_header>

<dtml-var "manage_form_title(this(), _,
           form_title='Add Z %s Database Connection' % database_type,
           )">

<main class="container-fluid">
  <form action="manage_add&dtml-database_type;Connection" method="post">

    <div class="form-group row">
      <label for="fb-id" class="col-sm-3 col-form-label">Id</label>
      <div class="col-sm-9">
        <input type="text" class="form-control" id="fb-id" name="id" value="">
      </div>
    </div>

    <div class="form-group row">
      <label for="fb-title" class="col-sm-3 col-form-label">Title</label>
      <div class="col-sm-9">
        <input type="text" class="form-control" id="fb-title" name="title" value="">
      </div>
    </div>

    <div class="form-group row">
      <label for="fb-connection" class="col-sm-3 col-form-label">Data source</label>
      <div class="col-sm-9">
        <input type="text" class="form-control" id="fb-connection" name="connection"
               placeholder="dsn=host:/path/to/database.fdb user=sysdba password=masterkey">
        <small class="form-text text-muted">Space-separated <code>key=value</code> pairs:
          <code>dsn=host[:port]/path user=myname password=pass</code></small>
      </div>
    </div>

    <div class="form-group row">
      <div class="col-sm-3"></div>
      <div class="col-sm-9">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="fb-check"
                 name="check" value="YES" checked>
          <label class="form-check-label" for="fb-check">Connect immediately</label>
        </div>
      </div>
    </div>

    <div class="zmi-controls">
      <input class="btn btn-primary" type="submit" name="submit" value="Add">
    </div>
  </form>
</main>

<dtml-var manage_page_footer>
